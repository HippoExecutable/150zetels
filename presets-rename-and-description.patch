diff --git a/src/tests/parsePreset.test.ts b/src/tests/parsePreset.test.ts
new file mode 100644
index 0000000..9c77965
--- /dev/null
+++ b/src/tests/parsePreset.test.ts
@@ -0,0 +1,221 @@
+/*
+    Parliament (parliament-seats) is a tool for visualizing and calculating
+    the distribution of seats in a parliamentary system.
